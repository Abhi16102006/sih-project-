# ---- Chain ----
# Local Hardhat node. Point this at a real RPC to deploy to Polygon.
RPC_URL=http://127.0.0.1:8545

# Private key used by the server to sign demo transactions so artists do not
# need MetaMask. `npm run deploy` writes the freshly generated key here.
DEPLOYER_PRIVATE_KEY=

# Account used to file "this looks like a copy" reports. It must differ from
# the deployer: the contract refuses self-flagging.
REPORTER_PRIVATE_KEY=

# ---- App ----
# Change this in any real deployment.
AUTH_SECRET=
