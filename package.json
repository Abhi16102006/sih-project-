{
  "name": "kalasecure-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n chain,web -c yellow,cyan \"npm:chain\" \"npm:web\"",
    "web": "next dev",
    "chain": "node scripts/dev-chain.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:reset": "hardhat run scripts/deploy.js --network localhost --reset",
    "seed": "node scripts/seed.js",
    "setup": "npm run compile && npm run deploy && npm run seed",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "roughjs": "^4.6.6",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "hardhat": "^2.29.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
